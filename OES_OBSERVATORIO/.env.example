# Configuración del Observatorio de Educación Superior (OES)
# Copie este archivo a .env si desea sobrescribir las configuraciones por defecto.

# Ruta de la base de datos (por defecto: database/oes.db)
OES_DB_PATH=database/oes.db

# Configuración del servidor Streamlit
PORT=8501
HOST=localhost

# Modo de ejecución (development / production)
ENV_MODE=development

# Configuración de Inteligencia Artificial (Opcional)
# El sistema cuenta con un motor local determinista basado en reglas y PLN simbólico.
# Si cuenta con una API key externa (OpenAI / Gemini), configúrela aquí:
AI_PROVIDER=local_rules
EXTERNAL_AI_API_KEY=

